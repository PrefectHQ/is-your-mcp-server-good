{
  "mcpServers": {
    "prefect-1to1": { "command": "uvx", "args": ["--from", "git+https://github.com/PrefectHQ/is-your-mcp-server-good", "prefect-servers", "one-to-one"] },
    "prefect-trimmed": { "command": "uvx", "args": ["--from", "git+https://github.com/PrefectHQ/is-your-mcp-server-good", "prefect-servers", "trimmed"] },
    "prefect-codemode": { "command": "uvx", "args": ["--from", "git+https://github.com/PrefectHQ/is-your-mcp-server-good", "prefect-servers", "code-mode"] },
    "prefect-designed": {
      "command": "uvx",
      "args": ["--from", "prefect-mcp", "prefect-mcp-server"],
      "env": { "PREFECT_API_URL": "http://localhost:4200/api" }
    }
  }
}
